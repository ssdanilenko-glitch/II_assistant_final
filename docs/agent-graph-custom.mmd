graph TD;
    __start__([START]):::first
    call_model[call_model<br/>Вызов LLM]
    execute_tool[execute_tool<br/>Выполнение безопасных инструментов<br/><i>search_knowledge_base, get_helpdesk_status</i>]
    prepare_email[prepare_email<br/>Подготовка draft письма<br/><i>tool_call send_email</i>]
    confirm_and_send[confirm_and_send<br/>Interrupt + отправка после подтверждения]
    force_finish[force_finish<br/>Завершение]
    __end__([END]):::last

    __start__ --> call_model
    call_model -->|есть send_email| prepare_email
    call_model -->|другие tool_calls| execute_tool
    call_model -->|нет tool_calls или лимит итераций| force_finish
    execute_tool --> call_model
    prepare_email --> confirm_and_send
    confirm_and_send -->|письмо отправлено / отменено| call_model
    force_finish --> __end__

    classDef default fill:#f2f0ff,line-height:1.2
    classDef first fill-opacity:0
    classDef last fill:#bfb6fc