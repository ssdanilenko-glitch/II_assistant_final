# =====================================================================
# ИТ-ассистент: пример переменных окружения
# Скопируйте в .env и заполните реальными значениями.
# =====================================================================

# ---------- Приложение ----------
APP_NAME=it_assistant
DEBUG=false
CORS_ORIGINS=["http://localhost:3000"]

# ---------- Redis ----------
REDIS_URL=redis://redis:6379/0
CACHE_TTL_SECONDS=86400

# ---------- LLM (Ollama / OpenAI-совместимый API) ----------
# Ключ: для Ollama можно указать любой (например, "ollama"), для OpenAI — реальный.
LLM__OPENAI_API_KEY=ollama
# Базовый URL: для Ollama — http://ollama:11434/v1, для прокси — https://api.proxyapi.ru/openai/v1
LLM__BASE_URL=http://ollama:11434/v1
# Модель: должна быть загружена в Ollama (например, frob/qwen3.5-instruct:4b, qwen2.5:7b)
LLM__DEFAULT_MODEL=frob/qwen3.5-instruct:4b
LLM__REQUEST_TIMEOUT=180
LLM__MAX_RETRIES=3

# ---------- Ollama ----------
# URL нативного API Ollama (без /v1) — используется в RAG-сервисе.
OLLAMA_URL=http://ollama:11434

# ---------- Vision (описание изображений) ----------
# Модель для media_processor. Для локальной Ollama — та же, что LLM__DEFAULT_MODEL.
VISION_MODEL=frob/qwen3.5-instruct:4b

# ---------- Чат (хранение) ----------
DATABASE_URL=postgresql+asyncpg://chat:chat@postgres:5432/chat
POSTGRES_PASSWORD=chat
CHAT_REPOSITORY=json
CHAT_STORAGE_DIR=./var/chats
CHAT_CONTEXT_WINDOW=10

# ---------- Telegram bot ----------
# Токен от @BotFather (обязателен для работы Telegram-бота).
BOT_TOKEN=123456789:AAaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaa
BACKEND_URL=http://app:8000
# ID администраторов через запятую (без пробелов).
BOT_ADMIN_IDS=123456789,987654321

# ---------- Service-to-service ----------
# Внутренний токен для backend ↔ bot (X-Internal-Token).
# Сгенерировать: openssl rand -hex 32
INTERNAL_TOKEN=change-me-with-openssl-rand-hex-32
# URL бота для обратного канала /notify.
BOT_URL=http://bot:9000
BOT_API_PORT=9000
API_BASE_URL=http://app:8000
TELEGRAM_EDIT_DEBOUNCE_MS=800

# ---------- Администрирование ----------
# X-Admin-Token для /chats/admin/*. Сгенерировать: openssl rand -hex 32
ADMIN_TOKEN=change-me-with-openssl-rand-hex-32
# Telegram chat_id админ-группы для алертов (опционально).
# ADMIN_CHAT_ID=-1001234567890
# Модерация через внешний судья (по аналогии с RAGAS). false — только regex.
MODERATION_USE_OPENAI=true
RATE_LIMIT_MESSAGES_PER_MIN=15

# ---------- Qdrant ----------
QDRANT_URL=http://qdrant:6333
# API-ключ нужен только для Qdrant Cloud. Для локального Qdrant оставьте пустым.
QDRANT_API_KEY=
# Legacy-коллекция (не используется в RAG-пайплайне).
QDRANT_COLLECTION=documents

# ---------- Эмбеддинги (HuggingFace BGE-M3) ----------
# Модель эмбеддингов (локальная). Для BGE-M3 размерность 1024.
EMBEDDING__MODEL_NAME=BAAI/bge-m3
EMBEDDING__DEVICE=cpu
# Для BGE-M3 обязателен trust_remote_code=true.
EMBEDDING__TRUST_REMOTE_CODE=true
# Размерность вектора (справочно, определяется моделью).
EMBEDDING__DIM=1024

# ---------- RAG ----------
RAG_DATA_DIR=/app/data/rag-block-03
RAG_COLLECTION=rag_block_04
RAG_COLLECTION_BARE=rag_block_04_bare
RAG_TOP_K=3
RAG_CHUNK_SIZE=512
RAG_CHUNK_OVERLAP=64
RAG_SCORE_THRESHOLD=0.5
RAG_RETRIEVE_TOP_K=10
RAG_RERANK_TOP_N=5
RAG_USE_RERANKER=false
RAG_RERANKER_MODEL=BAAI/bge-reranker-v2-m3
RAG_USE_HYBRID=false
RAG_SPARSE_MODEL=Qdrant/bm25
RAG_RESTRICT_TO_INTERNAL=false

# ---------- Агент и чекпоинтер ----------
# memory | sqlite | postgres
AGENT_CHECKPOINTER=postgres
AGENT_SQLITE_PATH=var/agent_checkpoints.sqlite

# ---------- Phoenix-трейсинг (опционально) ----------
PHOENIX_ENABLED=false
PHOENIX_COLLECTOR_ENDPOINT=http://phoenix:6006/v1/traces

# ---------- Оценка качества (RAGAS) ----------
# Судья для RAGAS. Провайдер: openai или anthropic.
EVAL_JUDGE_PROVIDER=openai
EVAL_JUDGE_MODEL=gpt-4o-mini
# URL для судьи (OpenAI-совместимый прокси).
EVAL_JUDGE_URL=https://api.proxyapi.ru/openai/v1
# Для провайдера anthropic:
# ANTHROPIC_API_KEY=

# ---------- Email (SMTP Yandex) ----------
YANDEX_EMAIL=user@yandex.ru
YANDEX_APP_PASSWORD=your_app_password
SMTP_HOST=smtp.yandex.ru
SMTP_PORT=465
# Получатель заявок HelpDesk (обычно отличается от отправителя).
EXCHANGE_RECIPIENT_EMAIL=helpdesk@company.com